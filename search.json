---
layout: null
sitemap: false
---
{% assign all_posts = site.tech | concat: site.misc | concat: site.education %}
{% assign all_posts = all_posts | sort: 'date' | reverse %}
[
{% for post in all_posts %}
  {
    "title": {{ post.title | default: "Untitled" | jsonify }},
    "url": {{ post.url | absolute_url | jsonify }},
    "date": {{ post.date | date: "%B %-d, %Y" | jsonify }},
    "collection": {{ post.collection | jsonify }},
    "categories": {{ post.categories | join: ", " | jsonify }},
    "tags": {{ post.tags | join: ", " | jsonify }},
    "excerpt": {{ post.content | strip_html | strip_newlines | truncate: 260 | jsonify }},
    "body": {{ post.content | strip_html | strip_newlines | truncate: 3000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
